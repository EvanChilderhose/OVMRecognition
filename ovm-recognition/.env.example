# Copy this to .env for local testing. On Render, you'll enter these
# as "Environment Variables" in the dashboard instead of a file.

# From Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# From GoHighLevel: Settings -> Private Integrations -> Create -> Copy the token
GHL_API_KEY=

# From GoHighLevel: Settings -> Business Profile (or the URL when you're logged in) -> Location ID
GHL_LOCATION_ID=

# Any password you choose — this is what you and your managers will type in
# to open the dashboard. Keep it simple but not guessable.
DASHBOARD_PASSCODE=changeme

# A long random string you make up (e.g. mash the keyboard for 30+ characters).
# Put the same value in the "secret" field of the GHL webhook body — it proves
# inbound texts really came from GHL. See README section 3.
WEBHOOK_SECRET=

# Timezone used for "what day is it?" (birthdays, anniversaries, the 7 AM check)
TIMEZONE=America/Toronto

PORT=3000
